# Environment Configuration for PeoplePrime HR Agentic RAG Copilot
# Copy this file to .env and provide your actual API keys. Never commit .env to source control.

# Application Information
APP_NAME="PeoplePrime HR Policy Agentic RAG Copilot"
APP_ENV="development"

# LLM Provider (Groq API)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Vector Database (Pinecone)
PINECONE_API_KEY="pcsk_your_pinecone_api_key_here"
PINECONE_INDEX_NAME="peopleprime-hr-kb-384"
PINECONE_NAMESPACE="peopleprime-policies"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"

# Local Embedding Model (Runs locally via sentence-transformers, dimension must match Pinecone index: 384)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Web Search API (Tavily Fallback)
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# Retrieval & Workflow Configuration
TOP_K=4
MAX_RETRIES=1

# Security & Administration
ADMIN_API_KEY="generate-a-strong-random-token-here"
